%% D2.2 Advanced EU Kernel EPC Engine integration
C --> CE0[Run OpenBEP4EU Calculation Engine D2.2]

subgraph CE[OpenBEP4EU Calculation Engine D2.2]
direction TB
CE1[Data Import\nJSON OpenBEP model or IFC4 Add2 DTV]
CE2[Data Validation\nSchema, references, semantic constraints]
CE3[Data Transformation\nHelpers prepare module-specific inputs]
CE4[Simulation Core Modules\nEN ISO 52016-1 hourly needs\nEN ISO 6946/13370/13789 envelope\nEN ISO 52010-1 climate\nEN 16798-1 indoor/operation\nEN 15316 and ISO 52031/52032 systems]
CE5[Orchestration Layer\nExecution sequence + intermediate results]
CE6[EPC-relevant Outputs\nFinal energy by carrier\nPrimary energy\nOperational GHG emissions\nOn-site RES share]
end

CE0 --> CE1 --> CE2 --> CE3 --> CE4 --> CE5 --> CE6
CE6 --> EPB4
end

subgraph UM[User management and permissions workflow]
direction TD

    OpenApp([User opens app]) --> HasAccount{Does user have an account?}
    HasAccount -->|No| Register[Register account<br/>view/register.html]
    Register --> RegistrationSuccess[Registration successful]
    RegistrationSuccess --> Login([User logs in<br/>view/login.html])
    HasAccount -->|Yes| Login
    Login --> Auth{Is user authenticated?}

    Auth -->|No| Denied[Access denied: show login error]
    Denied --> Login

    Auth -->|Yes| AuthenticatedUser[Authenticated user]
    AuthenticatedUser --> ProfilePage[User profile page<br/>view/user-profile.html]
    ProfilePage --> EditOwnProfile[Can edit own profile data]
    ProfilePage -->|Back to projects| ProjectList
    AuthenticatedUser --> AdminCheck{Is user a site admin?}

    AdminCheck -->|No| ProjectCheck{Does user already belong to a project?}
    ProjectCheck -->|No| CreateProject[Create project<br/>view/create-project.html]
    CreateProject --> BecomeOwner[User becomes project owner]
    BecomeOwner --> OwnerManagementPage

    ProjectCheck -->|No: browse existing| ProjectList[Project list page<br/>view/project-list.html]
    ProjectList -->|Click project row/name| ProjectDetail[Project details popup<br/>inside view/project-list.html]
    ProjectDetail --> AskMembership[User asks to become a member]
    AskMembership --> MembershipRequest[Membership request waits for owner approval]
    MembershipRequest --> Pending[Pending membership request / applicant state\nStatus shown in Project List\nview/project-list.html]
    MembershipRequest -->|Visible only to owner| OwnerManagementPage

    ProjectCheck -->|Yes: already member of specific project| ApprovedUser[Approved project user]

    OwnerManagementPage -->|Owner enters registered user email| EmailExists{Does email exist as registered user?}
    EmailExists -->|Yes| DirectMember[User becomes approved project member]
    EmailExists -->|No| EmailError[Show error: user with email does not exist]
    EmailError --> OwnerManagementPage
    Pending --> ProjectList
    Pending --> NoAccess[No project building access yet]

    ApprovedUser --> UserPage[Project List access\nCan open approved project dashboard]
    UserPage --> UserCreate[Can create buildings]
    UserPage --> UserEditOwn[Can edit only own buildings]
    UserPage --> UserNoEditOthers[Cannot edit buildings created by other users]

    ProjectCheck -->|Yes: project owner| OwnerManagementPage[Project Owner area / Project Users management<br/>Can manage project users<br/>Can add registered user by email<br/>view/project-users.html]
    OwnerManagementPage -->|Owner reviews pending requests| OwnerDecision{Approve invitation?}
    OwnerDecision -->|Approve| OwnerApprove[Invitation becomes approved]
    OwnerDecision -->|Disapprove| OwnerDisapprove[Invitation becomes disapproved]
    OwnerApprove --> ApprovedUser
    OwnerDisapprove --> NoAccess
    DirectMember --> ApprovedUser
    OwnerManagementPage --> OwnerEditAll[Can edit all buildings under own project]
    AdminCheck -->|Yes| SiteAdminPage[Site Admin Console<br/>Project Owners list + direct Project List action<br/>view/site-admin-console.html]
    SiteAdminPage --> SiteAdminOwners[Project Owners list]
    SiteAdminOwners --> SelectOwner[Select Project Owner]
    SiteAdminPage --> SiteAdminDirectProjectList[Open normal Project List as Site Admin<br/>Direct admin project access banner]
    SelectOwner --> BecomeOwnerView[Continue as selected Project Owner<br/>Show clear admin-as-owner banner]
    BecomeOwnerView --> OwnerSelectedProjects[Open normal Project List as selected owner]
    OwnerSelectedProjects --> PL
    SiteAdminDirectProjectList --> PL
    BecomeOwnerView --> ExitOwnerView[Exit selected-owner view<br/>Return to Project Owners list]
    ExitOwnerView --> SiteAdminPage
    BecomeOwnerView --> SiteAdminAllProjects[Can manage projects owned by selected owner]
    SiteAdminAllProjects --> SiteAdminEditAll[Can edit selected owner's project dashboards and child pages]
    SiteAdminEditAll --> SiteAdminCreateAny[Can create/edit buildings, SRI and EPB<br/>through existing owner pages]
    SiteAdminDirectProjectList --> SiteAdminAnyDashboard[Can open any project dashboard]
    SiteAdminAnyDashboard --> SiteAdminDirectEdit[Can create/edit buildings, SRI and EPB<br/>through existing normal pages]

    subgraph AccessRules[Final building access rules]
        Rule1[Approved regular user: create building + edit own buildings only]
        Rule2[Project owner: edit all buildings in their project]
        Rule3[Site admin selected-owner mode: create and edit buildings managed by selected Project Owner]
        Rule5[Site admin direct mode: open any project dashboard and edit through normal pages]
        Rule4[Authenticated user: edit own profile data]
    end

    EditOwnProfile --> Rule4
    UserCreate --> Rule1
    UserEditOwn --> Rule1
    OwnerEditAll --> Rule2
    SiteAdminEditAll --> Rule3
    SiteAdminCreateAny --> Rule3
    SiteAdminDirectEdit --> Rule5

    classDef page fill:#e8f4ff,stroke:#1f77b4,stroke-width:2px,color:#102a43
    classDef decision fill:#fff3cd,stroke:#d39e00,stroke-width:2px,color:#3d2b00
    classDef approved fill:#eaf7ea,stroke:#2db34a,stroke-width:2px,color:#123d1b
    classDef rejected fill:#fdecea,stroke:#ef3e23,stroke-width:2px,color:#4a120a
    classDef role fill:#f3eefc,stroke:#6f42c1,stroke-width:2px,color:#25113f
    classDef rule fill:#f7f7f7,stroke:#666,stroke-width:1px,color:#222

    class OpenApp,Login,Register,RegistrationSuccess,Pending,UserPage,ProfilePage,OwnerManagementPage,SiteAdminPage,SiteAdminOwners,SelectOwner,BecomeOwnerView,OwnerSelectedProjects,ExitOwnerView,CreateProject,ProjectList,ProjectDetail,AskMembership,MembershipRequest,SiteAdminDirectProjectList,PS page
    class HasAccount,Auth,AdminCheck,ProjectCheck,OwnerDecision,EmailExists decision
    class AuthenticatedUser,ApprovedUser,UserCreate,UserEditOwn,EditOwnProfile,OwnerApprove,BecomeOwner,DirectMember approved
    class Denied,NoAccess,UserNoEditOthers,OwnerDisapprove,EmailError rejected
    class OwnerEditAll,SiteAdminAllProjects,SiteAdminEditAll,SiteAdminCreateAny,SiteAdminAnyDashboard,SiteAdminDirectEdit role
    class Rule1,Rule2,Rule3,Rule4,Rule5 rule
end

