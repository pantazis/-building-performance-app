    classDef approved fill:#eaf7ea,stroke:#2db34a,stroke-width:2px,color:#123d1b
    classDef rejected fill:#fdecea,stroke:#ef3e23,stroke-width:2px,color:#4a120a
    classDef role fill:#f3eefc,stroke:#6f42c1,stroke-width:2px,color:#25113f
    classDef rule fill:#f7f7f7,stroke:#666,stroke-width:1px,color:#222

    class Login,Pending,UserPage,OwnerManagementPage,SiteAdminPage,CreateOrg,OrgList,OrgDetail,AskMembership,MembershipRequest page
    class Auth,AdminCheck,OrgCheck,OwnerDecision decision
    class ApprovedUser,UserCreate,UserEditOwn,OwnerApprove,BecomeOwner,DirectMember approved
    class Denied,NoAccess,UserNoEditOthers,OwnerDisapprove rejected
    class OwnerEditAll,SiteAdminAllOrgs,SiteAdminEditAll,SiteAdminCreateAny,SiteAdminManageAll role
    class Rule1,Rule2,Rule3 rule